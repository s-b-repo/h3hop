# Copy to .env and fill in.  NEVER commit the real .env (see .gitignore).

# OpenRouter — single key gives access to GLM-5.2 and DeepSeek-V4-Pro.
# https://openrouter.ai/keys
OPENROUTER_API_KEY=

# Optional: direct provider keys if you prefer not to route through OpenRouter.
# ZAI_API_KEY=
# DEEPSEEK_API_KEY=

# Optional: Hugging Face token for gated/base model downloads.
# HF_TOKEN=
